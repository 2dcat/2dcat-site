---
<Base
  title="Music & Shows | 2DCAT"
  description="Stream 2DCAT on Spotify, Apple Music, YouTube, and Bandcamp. Dark synthpop from Washington D.C. Live show dates and tickets."
  pageSchema={musicSchema}
>
  <section class="section" style="padding-top:7rem">
    <p class="section-label">Music</p>
    <h1>Listen</h1>

    <div class="music-grid">
      <div class="music-block">
        <p class="music-platform">Spotify</p>
        <iframe
          src="https://open.spotify.com/embed/artist/78CkUkpoNpLZbnIOv00M6Q?utm_source=generator&theme=0"
          width="100%"
          height="352"
          frameBorder="0"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      </div>

      <div class="music-block">
        <p class="music-platform">YouTube</p>
        <iframe
          src="https://www.youtube.com/embed/uMQNizvE31M"
          width="100%"
          height="352"
          frameBorder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>

    <div class="platform-links">
      <a href="https://music.apple.com/us/artist/2dcat/1100337687" target="_blank" rel="noopener" class="platform-btn">Apple Music</a>
      <a href="https://2dcat.bandcamp.com/" target="_blank" rel="noopener" class="platform-btn">Bandcamp</a>
      <a href="https://open.spotify.com/artist/78CkUkpoNpLZbnIOv00M6Q" target="_blank" rel="noopener" class="platform-btn">Spotify</a>
      <a href="https://www.youtube.com/@2dcat" target="_blank" rel="noopener" class="platform-btn">YouTube</a>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <p class="section-label">Live</p>
    <h2>Upcoming Shows</h2>

    <table style="margin-top:2rem" id="shows-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Venue</th>
          <th>City</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="shows-tbody">
        <tr id="shows-loading">
          <td colspan="4" style="color:var(--text-muted)">Loading shows...</td>
        </tr>
      </tbody>
    </table>

    <p style="margin-top:2rem;color:var(--text-muted)">
      <a href="https://www.bandsintown.com/a/14389701-2dcat" target="_blank" rel="noopener">Follow on Bandsintown</a> for all upcoming dates.
    </p>
  </section>
</Base>

<script>
  const APP_ID = '352c0582b5eea3177112491a25b9f1fd';

  async function loadShows() {
    const tbody = document.getElementById('shows-tbody');
    try {
      const res = await fetch(
        `https://rest.bandsintown.com/artists/2dcat/events/?app_id=${APP_ID}&date=upcoming`
      );
      if (!res.ok) throw new Error('API error');
      const events = await res.json();

      if (!Array.isArray(events) || events.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" style="color:var(--text-muted)">No upcoming shows.</td></tr>';
        return;
      }

      tbody.innerHTML = events.map(event => {
        const date = new Date(event.datetime);
        const dateStr = date.toLocaleDateString('en-US', {
          month: 'short', day: 'numeric', year: 'numeric'
        });
        const venue = event.venue?.name ?? '';
        const city = event.venue
          ? `${event.venue.city}${event.venue.country ? ', ' + event.venue.country : ''}`
          : '';
        const ticketUrl = event.offers?.[0]?.url ?? event.url ?? '#';

        return `<tr>
          <td>${dateStr}</td>
          <td>${venue}</td>
          <td>${city}</td>
          <td><a href="${ticketUrl}" target="_blank" rel="noopener">Tickets</a></td>
        </tr>`;
      }).join('');
    } catch (err) {
      tbody.innerHTML = '<tr><td colspan="4" style="color:var(--text-muted)">Could not load shows. <a href="https://www.bandsintown.com/a/14389701-2dcat" target="_blank" rel="noopener">Check Bandsintown directly.</a></td></tr>';
    }
  }

  loadShows();
</script>

<style>
.music-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  margin-top: 2rem;
}
.music-platform {
  font-family: var(--font-display);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.75rem;
}
.platform-links {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-top: 2rem;
}
.platform-btn {
  border: 1px solid var(--border);
  padding: 0.75rem 1.5rem;
  display: inline-block;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-size: 0.8rem;
  font-family: var(--font-display);
  transition: border-color 0.2s, color 0.2s;
  color: var(--text);
  border-bottom: 1px solid var(--border);
}
.platform-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
}
@media (max-width: 768px) {
  .music-grid { grid-template-columns: 1fr; }
}
</style>