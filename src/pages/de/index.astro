---
import BaseDE from '../../layouts/BaseDE.astro';
---
<BaseDE
  title="2DCAT | Dunkler Synthpop aus Washington DC"
  description="2DCAT ist ein Dark-Synthpop-Duo aus Washington, D.C. Analoggetriebene Synthesizer, markante Vocals und maschinengetriebene Rhythmen."
  canonicalURL="https://2dcat.com/de"
>
  <style>
    footer { display: none; }
    main { padding-top: 0; }
    .hero {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      z-index: 1;
    }
    .hero-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      z-index: 0;
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.5) 100%);
      z-index: 1;
    }
    .hero-content {
      position: absolute;
      bottom: 4rem;
      left: 2rem;
      z-index: 2;
    }
    header { z-index: 200; }
  </style>
  <div class="hero">
    <img src="/images/hero.jpg" alt="2DCAT" class="hero-img" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-tag">Washington D.C. &bull; Dunkler Synthpop</p>
      <h1>2DCAT</h1>
      <p class="hero-sub">Analoggetriebene Synthesizer. Markante Vocals. Musik für die Einsamkeit und die Tanzfläche.</p>
    </div>
  </div>
</BaseDE>