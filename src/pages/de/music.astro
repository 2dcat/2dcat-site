---
import BaseDE from '../../layouts/BaseDE.astro';
---
<BaseDE
  title="Musik & Shows | 2DCAT"
  description="2DCAT auf Spotify, Apple Music, YouTube und Bandcamp streamen. Dark Synthpop aus Washington D.C. Live-Shows und Tickets."
>
  <section class="section" style="padding-top:7rem">
    <p class="section-label">Musik</p>
    <h1>Hören</h1>

    <div class="music-grid">
      <div class="music-block">
        <p class="music-platform">Spotify</p>
        <iframe
          src="https://open.spotify.com/embed/artist/78CkUkpoNpLZbnIOv00M6Q?utm_source=generator&theme=0"
          width="100%"
          height="352"
          frameBorder="0"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      </div>

      <div class="music-block">
        <p class="music-platform">YouTube</p>
        <iframe
          src="https://www.youtube.com/embed/uMQNizvE31M"
          width="100%"
          height="352"
          frameBorder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>

    <div class="platform-links">
      <a href="https://music.apple.com/us/artist/2dcat/1100337687" target="_blank" rel="noopener" class="platform-btn">Apple Music</a>
      <a href="https://2dcat.bandcamp.com/" target="_blank" rel="noopener" class="platform-btn">Bandcamp</a>
      <a href="https://open.spotify.com/artist/78CkUkpoNpLZbnIOv00M6Q" target="_blank" rel="noopener" class="platform-btn">Spotify</a>
      <a href="https://www.youtube.com/@2dcat" target="_blank" rel="noopener" class="platform-btn">YouTube</a>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <p class="section-label">Live</p>
    <h2>Kommende Shows</h2>
    <table style="margin-top:2rem">
      <thead>
        <tr>
          <th>Datum</th>
          <th>Veranstaltungsort</th>
          <th>Stadt</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>24. Jul. 2026</td>
          <td>Echoes of Rebellion Festival</td>
          <td>Köln, DE</td>
          <td><a href="https://eventfrog.de/de/p/festivals/weitere-festivals/echoes-of-rebellion-2026-7356786551446100775.html" target="_blank" rel="noopener">Tickets</a></td>
        </tr>
      </tbody>
    </table>

    <p style="margin-top:2rem;color:var(--text-muted)">
      <a href="https://www.bandsintown.com/a/14389701-2dcat" target="_blank" rel="noopener">Auf Bandsintown folgen</a> für alle kommenden Termine.
    </p>
  </section>
</BaseDE>

<style>
.music-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  margin-top: 2rem;
}
.music-platform {
  font-family: var(--font-display);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.75rem;
}
.platform-links {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-top: 2rem;
}
.platform-btn {
  border: 1px solid var(--border);
  padding: 0.75rem 1.5rem;
  display: inline-block;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-size: 0.8rem;
  font-family: var(--font-display);
  transition: border-color 0.2s, color 0.2s;
  color: var(--text);
  border-bottom: 1px solid var(--border);
}
.platform-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
}
@media (max-width: 768px) {
  .music-grid { grid-template-columns: 1fr; }
}
</style>