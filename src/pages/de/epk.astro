---
import BaseDE from '../../layouts/BaseDE.astro';

const galleryImages = [
  "86ef3212.jpg",
  "62942adc.jpg",
  "6ffe881a.jpg",
  "74e920ec.jpg",
  "7682640a.jpg",
  "6589f4b0.jpg",
  "94aee7bd.jpg",
  "1f6b285e.jpg",
  "b71b89c5.jpg",
  "d1b64a0f.jpg",
];

const galleryAlts = [
  "2DCAT Live-Auftritt",
  "HAEZL auf der Bühne mit 2DCAT",
  "Johan auf der Bühne mit 2DCAT",
  "2DCAT Live-Show",
  "2DCAT Darkwave-Set",
  "HAEZL und Johan von 2DCAT",
  "2DCAT Konzertfoto",
  "2DCAT Auftritt",
  "2DCAT Bandfoto",
  "2DCAT Pressefoto",
];

const videosLeft = [
  "https://www.youtube.com/embed/uMQNizvE31M",
  "https://www.youtube.com/embed/-8wlpD8m2-8",
  "https://www.youtube.com/embed/y-BINpWprKI",
];

const videosRight = [
  "https://www.youtube.com/embed/qJmwQ2Ur1q8",
  "https://www.youtube.com/embed/AP0z_1VNPyw",
  "https://www.youtube.com/embed/OahPbFGc79U",
];

const epkSchema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Welches Genre spielt 2DCAT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "2DCAT ist ein Dark-Synthpop- und Darkwave-Duo aus Washington, D.C. Ihr Sound schöpft aus Coldwave-, Minimal-Wave- und EBM-Traditionen der europäischen elektronischen Musik der späten 1970er und frühen 1980er Jahre. Sie gehören zur Schwarzen Szene."
        }
      },
      {
        "@type": "Question",
        "name": "Wer sind die Mitglieder von 2DCAT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "2DCAT besteht aus HAEZL (Gesang und Theremin) und Johan (Synthesizer und Drummaschinen). HAEZL ist eine ausgebildete Opernsängerin, die gemeinsam mit Patti LaBelle, Cynthia Erivo und Renée Fleming aufgetreten ist. Johan entwirft und baut die analogen Synthesizer und FPGA-basierten Instrumente für die Live-Auftritte selbst."
        }
      },
      {
        "@type": "Question",
        "name": "Wo ist 2DCAT beheimatet?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "2DCAT ist in Washington, D.C. ansässig und tritt in Nordamerika und Europa auf. Deutschland ist ihr zweitgrößter Markt, mit besonders starkem Publikum in Berlin, Frankfurt und Hamburg."
        }
      },
      {
        "@type": "Question",
        "name": "Wie kann man 2DCAT buchen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "2DCAT ist für Buchungen in Nordamerika und Europa verfügbar. Buchungsanfragen bitte an booking@2dcat.net. E-Mail-Korrespondenz gerne auf Deutsch oder Englisch. Pressematerial und Techrider sind auf Anfrage erhältlich."
        }
      },
      {
        "@type": "Question",
        "name": "Wie ist das Live-Setup von 2DCAT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "2DCAT tritt live mit selbstgebauten analogen Synthesizern, FPGA-basierten Instrumenten und Hardware-Drummaschinen auf. HAEZL übernimmt Gesang und Theremin. Ihre Live-Sets haben Venues von 80 bis 500 Personen in den USA und Europa bespielt."
        }
      }
    ]
  }
];
---
<BaseDE
  title="EPK | 2DCAT — Dark Synthpop Pressemappe & Booking"
  description="Electronic Press Kit von 2DCAT, Dark-Synthpop-Duo aus Washington D.C. Booking, Pressematerial, Show-Historie und Publikumsdaten. Verfügbar für Nordamerika und Europa."
  pageSchema={epkSchema}
>

  <p class="crawl-only">
    Ähnliche Künstler: Lebanon Hanover, Boy Harsher, Kite, Ductape, NNHMN, Linea Aspera, Rue Oberkampf, SYZYGYX, Minuit Machine, Kontravoid, Echoberyl, Zanias, Potochkine, SDH, Riki, Vioflesh, Korine. Genres: Dark Synthpop, Darkwave, Coldwave, Minimal Wave, EBM, Post-Punk, Dark Electro, Schwarze Szene.
  </p>

  <!-- Booking-CTA oben — Booker scrollen selten bis zum Ende -->
  <section class="section booking-top" style="padding-top:7rem;padding-bottom:0">
    <div class="booking-bar">
      <div>
        <p class="section-label" style="margin:0 0 0.25rem">Booking</p>
        <p class="booking-avail">Verfügbar für Nordamerika und Europa</p>
      </div>
      <div class="booking-actions">
        <a href="mailto:booking@2dcat.net" class="epk-btn epk-btn-primary">booking@2dcat.net</a>
        <a href="https://drive.google.com/drive/u/1/folders/1oLPjSo92WIupT8DdGqErdnZNEKIVR7O9" target="_blank" rel="noopener" class="epk-btn">Pressematerial & Techrider</a>
      </div>
    </div>
    <p style="margin-top:0.75rem;color:var(--text-muted);font-size:0.85rem">E-Mail-Korrespondenz gerne auf Deutsch oder Englisch.</p>
  </section>

  <section class="section" style="padding-top:2rem">
    <p class="section-label">Electronic Press Kit</p>
    <div class="epk-hero">
      <img src="/images/image09.jpg" alt="2DCAT — Dark Synthpop Duo HAEZL und Johan, Washington D.C." class="epk-hero-img" />
    </div>

    <div class="stats-row" style="margin-top:0">
      <div class="stat"><span class="stat-number">3.2M</span><span class="stat-label">Spotify-Hörer</span></div>
      <div class="stat"><span class="stat-number">7.8M</span><span class="stat-label">Spotify-Wiedergaben</span></div>
      <div class="stat"><span class="stat-number">28.5K</span><span class="stat-label">Spotify-Follower</span></div>
      <div class="stat"><span class="stat-number">8.4K</span><span class="stat-label">Instagram-Follower</span></div>
      <div class="stat"><span class="stat-number">6.9K</span><span class="stat-label">Facebook-Follower</span></div>
      <div class="stat"><span class="stat-number">4.5K</span><span class="stat-label">YouTube-Follower</span></div>
    </div>

    <img src="/images/image01.jpg" alt="2DCAT Spotify-Publikumsdaten — Top-Märkte: Deutschland, USA und Vereinigtes Königreich" class="epk-audience" />

    <div class="epk-bio">
      <p>2DCAT ist das Dark-Synthpop-Duo aus Washington, D.C. von Sängerin HAEZL und Synthesist Johan Hauck. HAEZL, die gemeinsam mit Patti LaBelle, Cynthia Erivo und Renée Fleming auf der Bühne stand, bringt klassisch geschulte Kraft auf den Dancefloor. Johan entwirft und fertigt einen Großteil der Synthesizer, die auf der Bühne und auf den Aufnahmen zu hören sind, selbst.</p>
      <blockquote>
        An acclaimed opera singer, she brings precision and weight without overstatement: the diction is sharp, the range controlled, and the delivery heavy with the kind of grief that does not need to announce itself theatrically to be devastating.
        <cite>Post-Punk.com</cite>
      </blockquote>
      <p>In Washington, D.C. beheimatet, schöpft 2DCAT aus den Darkwave- und Coldwave-Stilen der elektronisch geprägten Musik Europas der späten 70er und frühen 80er Jahre. Ihre energiegeladenen Live-Sets haben ausverkaufte Club-Nächte und Festivalbühnen in den USA und Europa zum Leuchten gebracht.</p>
      <blockquote>
        A homemade electrical animal with wires for veins and bad intentions in its little metal heart.
        <cite>Post-Punk.com</cite>
      </blockquote>
      <p class="epk-fans">Für Fans von Lebanon Hanover, Boy Harsher und Kite.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <p class="section-label">Fotos</p>
    <div class="epk-gallery">
      {galleryImages.map((img, i) => (
        <div class="epk-gallery-item">
          <img src={`/images/${img}`} alt={galleryAlts[i]} />
        </div>
      ))}
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <p class="section-label">Video</p>
    <div class="epk-videos">
      <div class="epk-video-col">
        {videosLeft.map((url) => (
          <div class="epk-video">
            <iframe src={url} frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
        ))}
      </div>
      <div class="epk-video-col">
        {videosRight.map((url) => (
          <div class="epk-video">
            <iframe src={url} frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <p class="section-label" style="text-align:center">Live</p>
    <p class="shows-title">Aktuelle & Ausgewählte 2DCAT Shows</p>
    <table style="margin-top:2rem">
      <thead>
        <tr>
          <th>Veranstaltungsort</th>
          <th>Stadt</th>
          <th>Datum</th>
          <th>Kap.</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><a href="https://www.facebook.com/events/1354975093214623" target="_blank" rel="noopener">Darkflower</a></td><td>Leipzig, DE</td><td>31. Jul. 2026</td><td>150</td></tr>
        <tr><td><a href="https://www.facebook.com/events/1635388620870901" target="_blank" rel="noopener">Theater Drehleier</a></td><td>München, DE</td><td>30. Jul. 2026</td><td>150</td></tr>
        <tr><td><a href="https://www.facebook.com/events/1453404649333562" target="_blank" rel="noopener">Echoes of Rebellion Festival</a></td><td>Köln, DE</td><td>24. Jul. 2026</td><td>450</td></tr>
        <tr><td><a href="https://www.facebook.com/events/1562752635568307" target="_blank" rel="noopener">Simple Underground</a></td><td>Washington, DC</td><td>10. Jul. 2026</td><td>100</td></tr>
        <tr><td><a href="https://www.songkick.com/concerts/42775007-2dcat-at-oshaughnessys-pub" target="_blank" rel="noopener">O'Shaughnessy's</a></td><td>Alexandria, VA</td><td>18. Okt. 2025</td><td>150</td></tr>
        <tr><td><a href="https://www.setlist.fm/setlist/2dcat/2025/cult-classic-brewing-company-stevensville-md-1b420d58.html" target="_blank" rel="noopener">Cult Classic Brewing</a></td><td>Kent Island, MD</td><td>24. Jul. 2025</td><td>185</td></tr>
        <tr><td><a href="https://www.washingtonpost.com/dc-md-va/2025/07/17/best-things-to-do-dc-events/" target="_blank" rel="noopener">Penn Social</a></td><td>Washington, DC</td><td>19. Jul. 2025</td><td>500</td></tr>
        <tr><td><a href="https://www.facebook.com/events/775637498119943/" target="_blank" rel="noopener">The Renegade</a></td><td>Arlington, VA</td><td>17. Jul. 2025</td><td>300</td></tr>
        <tr><td><a href="https://www.facebook.com/events/1234022641450508" target="_blank" rel="noopener">QXT's</a></td><td>Newark, NJ</td><td>21. Jun. 2025</td><td>300</td></tr>
        <tr><td><a href="https://www.facebook.com/events/1406388667167798" target="_blank" rel="noopener">Remedy</a></td><td>Pittsburgh, PA</td><td>19. Jun. 2025</td><td>80</td></tr>
        <tr><td><a href="https://www.facebook.com/events/1033350351691339" target="_blank" rel="noopener">Metro Baltimore</a></td><td>Baltimore, MD</td><td>21. Sep. 2024</td><td>250</td></tr>
        <tr><td><a href="https://www.facebook.com/events/2519398508254113" target="_blank" rel="noopener">The Passenger</a></td><td>Washington, DC</td><td>2. Aug. 2024</td><td>100</td></tr>
        <tr><td><a href="https://www.facebook.com/events/369905078784668" target="_blank" rel="noopener">Pie Shop</a></td><td>Washington, DC</td><td>23. Apr. 2024</td><td>150</td></tr>
        <tr><td><a href="https://www.facebook.com/events/1062512198140670/" target="_blank" rel="noopener">The Crack Fox</a></td><td>St. Louis, MO</td><td>18. Apr. 2024</td><td>200</td></tr>
        <tr><td><a href="https://www.facebook.com/events/1508399573035411" target="_blank" rel="noopener">The Runaway</a></td><td>Washington, DC</td><td>13. Jan. 2024</td><td>150</td></tr>
      </tbody>
    </table>
  </section>

  <section class="section" style="padding-top:0">
    <p class="section-label">Presse & Features</p>
    <table>
      <thead>
        <tr>
          <th>Publikation</th>
          <th>Art</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><a href="https://www.femalevoices.de/2dcat-im-darkflower/" target="_blank" rel="noopener">Female Voices <span class="press-context">(DE)</span></a></td><td>Live-Show-Review</td></tr>
        <tr><td><a href="https://monkeypress.de/2026/07/fotos/fotos-echoes-of-rebellion-2026-koeln-club-volta/" target="_blank" rel="noopener">Monkeypress <span class="press-context">(DE)</span></a></td><td>Live-Konzertfotos</td></tr>
        <tr><td><a href="https://sidelinemag.bandcamp.com/album/united-1-the-freya-files" target="_blank" rel="noopener">Side-Line Magazine <span class="press-context">(The Freya Files)</span></a></td><td>Kompilation</td></tr>
        <tr><td><a href="https://renramos.bandcamp.com/merch/13-tridecaphobia" target="_blank" rel="noopener">Nocturnazine <span class="press-context">(Ausgabe 13)</span></a></td><td>Album-Review</td></tr>
        <tr><td><a href="https://post-punk.com/dc-dark-synthpop-duo-2dcat-take-a-sledgehammer-to-grief-in-video-for-lynchian-blue-rose-edit-of-frames/" target="_blank" rel="noopener">Post-Punk.com</a></td><td>Feature / Video Premiere</td></tr>
        <tr><td><a href="https://post-punk.com/keep-us-blinded-and-starving-dc-dark-synthpop-duo-2dcat-take-class-rage-to-the-factory-floor-in-video-for-eat-the-rich/" target="_blank" rel="noopener">Post-Punk.com</a></td><td>Feature</td></tr>
        <tr><td><a href="https://schwarz-ontour.de/interview-2dcat/" target="_blank" rel="noopener">Schwarz on Tour <span class="press-context">(DE)</span></a></td><td>Interview</td></tr>
        <tr><td><a href="https://regenmag.com/news/news-2dcat-champions-strength-and-dignity-against-idolatry-and-prayer-with-latest-single-hinting-at-upcoming-full-length-album/" target="_blank" rel="noopener">Regen Magazine</a></td><td>Feature</td></tr>
        <tr><td><a href="https://thestateofsynth.com/podcast/s9e12-sad-cats-and-sting-in-a-codpiece/" target="_blank" rel="noopener">The State of Synth</a></td><td>Podcast-Interview</td></tr>
        <tr><td><a href="https://www.youtube.com/live/obGJHGBKoaQ?si=JcFJlzJhruLzHkM0" target="_blank" rel="noopener">Eclectic Arts Media</a></td><td>Video-Interview</td></tr>
        <tr><td><a href="https://www.imdb.com/title/tt26702944/" target="_blank" rel="noopener">Beyond Synth</a></td><td>Podcast-Interview</td></tr>
        <tr><td><a href="https://parklifedc.com/2025/04/28/a-conversation-about-nick-cave-and-the-bad-seeds-with-2dcats-johan-hauck-live-the-anthem-4-21-25/" target="_blank" rel="noopener">Parklife DC</a></td><td>Feature</td></tr>
        <tr><td><a href="https://dreadmusicreview.com/2024/10/16/2dcat-addresses-societal-pressures-for-women-with-their-haunting-allie-x-cover/" target="_blank" rel="noopener">Dread Music Review</a></td><td>Feature</td></tr>
        <tr><td><a href="https://www.youtube.com/watch?v=jgQ_tWS0ExI" target="_blank" rel="noopener">Communion After Dark</a></td><td>Podcast-Feature</td></tr>
      </tbody>
    </table>
  </section>

  <section class="section" style="padding-top:0">
    <p class="section-label">Sync & Lizenzplatzierungen</p>
    <table>
      <thead>
        <tr><th>Titel</th><th>Art</th></tr>
      </thead>
      <tbody>
        <tr><td><a href="https://store.steampowered.com/app/1669670/SEQUENCE_STORM__Olokun_Dive_Expansion_Pack/" target="_blank" rel="noopener">Sequence Storm</a></td><td>Videospiel</td></tr>
        <tr><td><a href="https://www.imdb.com/title/tt7134690/" target="_blank" rel="noopener">I Like Me</a></td><td>Spielfilm</td></tr>
      </tbody>
    </table>
  </section>

</BaseDE>

<style>
.crawl-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  border: 0;
}
.booking-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1.5rem;
  padding: 1.5rem 2rem;
  border: 1px solid var(--accent);
  margin-bottom: 1rem;
}
.booking-avail {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin: 0;
}
.booking-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  align-items: center;
}
.epk-btn-primary {
  border-color: var(--accent);
  color: var(--accent);
}
.epk-hero-img {
  width: 100%;
  max-height: 500px;
  object-fit: cover;
  object-position: center top;
  display: block;
}
.epk-audience {
  width: 100%;
  max-width: 700px;
  display: block;
  margin: 2rem auto;
}
.epk-bio {
  max-width: 800px;
  margin: 2rem auto 0;
  text-align: center;
}
.epk-bio blockquote { text-align: left; }
.epk-bio p { margin-bottom: 1.5rem; }
.epk-fans { color: var(--text-muted); }
.epk-gallery {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 0.5rem;
  margin-top: 1rem;
}
.epk-gallery-item img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  display: block;
}
.epk-videos {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-top: 1rem;
}
.epk-video-col {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.epk-video iframe {
  width: 100%;
  aspect-ratio: 16/9;
  display: block;
}
.shows-title {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-align: center;
  color: var(--text);
  margin-top: 0.5rem;
}
.press-context {
  font-size: 0.8em;
  color: var(--text-muted);
}
.epk-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}
.epk-btn {
  border: 1px solid var(--border);
  padding: 0.75rem 1.5rem;
  display: inline-block;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-size: 0.8rem;
  font-family: var(--font-display);
  transition: border-color 0.2s, color 0.2s;
  color: var(--text);
}
.epk-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
}
.epk-btn-print {
  background: none;
  cursor: pointer;
}
@media (max-width: 768px) {
  .epk-videos { grid-template-columns: 1fr; }
  .epk-gallery { grid-template-columns: repeat(2, 1fr); }
  .booking-bar { flex-direction: column; align-items: flex-start; }
}
</style>