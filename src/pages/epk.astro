---
import Base from '../layouts/Base.astro';

const galleryImages = [
  "86ef3212.jpg",
  "62942adc.jpg",
  "6ffe881a.jpg",
  "74e920ec.jpg",
  "7682640a.jpg",
  "6589f4b0.jpg",
  "94aee7bd.jpg",
  "1f6b285e.jpg",
  "b71b89c5.jpg",
  "d1b64a0f.jpg",
];

const galleryAlts = [
  "2DCAT live performance",
  "HAEZL performing with 2DCAT",
  "Johan performing with 2DCAT",
  "2DCAT live on stage",
  "2DCAT performing darkwave set",
  "HAEZL and Johan of 2DCAT",
  "2DCAT live show",
  "2DCAT performing",
  "2DCAT band photo",
  "2DCAT press photo",
];

const videosLeft = [
  "https://www.youtube.com/embed/uMQNizvE31M",
  "https://www.youtube.com/embed/-8wlpD8m2-8",
  "https://www.youtube.com/embed/y-BINpWprKI",
];

const videosRight = [
  "https://www.youtube.com/embed/qJmwQ2Ur1q8",
  "https://www.youtube.com/embed/AP0z_1VNPyw",
  "https://www.youtube.com/embed/OahPbFGc79U",
];

const epkSchema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What genre is 2DCAT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "2DCAT is a dark synthpop and darkwave duo from Washington, D.C. Their sound draws from coldwave, minimal wave, and EBM traditions rooted in late 1970s and early 1980s European electronic music. They belong to the Schwarze Szene."
        }
      },
      {
        "@type": "Question",
        "name": "Who are the members of 2DCAT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "2DCAT consists of HAEZL on vocals and theremin, and Johan on synthesizers and drum machines. HAEZL is an opera-trained vocalist who has performed alongside Patti LaBelle, Cynthia Erivo, and Renée Fleming. Johan designs and fabricates the analog synthesizers and FPGA-based instruments used in live performance."
        }
      },
      {
        "@type": "Question",
        "name": "Where is 2DCAT based?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "2DCAT is based in Washington, D.C. and performs across North America and Europe, with a strong audience in Germany, particularly in Berlin, Frankfurt, and Hamburg."
        }
      },
      {
        "@type": "Question",
        "name": "How can I book 2DCAT for a show?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "2DCAT is available for booking in North America and Europe. Contact booking@2dcat.net for inquiries. Press assets and a technical rider are available on request."
        }
      },
      {
        "@type": "Question",
        "name": "What is 2DCAT's live setup?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "2DCAT performs live with a combination of custom-built analog synthesizers, FPGA-based instruments designed and fabricated by Johan, and hardware drum machines. HAEZL performs vocals and theremin. Their live sets have played venues from 80 to 500 capacity across the US and Europe."
        }
      }
    ]
  }
];
---
<Base
  title="EPK | 2DCAT — Dark Synthpop Press Kit & Booking"
  description="Electronic press kit for 2DCAT, dark synthpop duo from Washington D.C. Booking, press assets, show history, and audience data. Available for North America and Europe."
  pageSchema={epkSchema}
>

  <!-- Similar artists visible to crawlers, hidden visually but NOT aria-hidden -->
  <p class="crawl-only">
    Similar artists: Lebanon Hanover, Boy Harsher, Kite, Ductape, NNHMN, Linea Aspera, Rue Oberkampf, SYZYGYX, Minuit Machine, Kontravoid, Echoberyl, Zanias, Potochkine, SDH, Riki, Vioflesh, Korine. Genres: dark synthpop, darkwave, coldwave, minimal wave, EBM, post-punk, dark electro, Schwarze Szene.
  </p>

  <!-- Booking CTA at top — bookers scan EPKs in under 30 seconds -->
  <section class="section booking-top" style="padding-top:7rem;padding-bottom:0">
    <div class="booking-bar">
      <div>
        <p class="section-label" style="margin:0 0 0.25rem">Booking</p>
        <p class="booking-avail">Available for North America and Europe</p>
      </div>
      <div class="booking-actions">
        <a href="mailto:booking@2dcat.net" class="epk-btn epk-btn-primary">booking@2dcat.net</a>
        <a href="https://drive.google.com/drive/u/1/folders/1oLPjSo92WIupT8DdGqErdnZNEKIVR7O9" target="_blank" rel="noopener" class="epk-btn">Press Assets & Tech Rider</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:2rem">
    <p class="section-label">Electronic Press Kit</p>
    <div class="epk-hero">
      <img src="/images/image09.jpg" alt="2DCAT — dark synthpop duo HAEZL and Johan, Washington D.C." class="epk-hero-img" />
    </div>

    <div class="stats-row" style="margin-top:0">
      <div class="stat"><span class="stat-number">3.1M</span><span class="stat-label">Spotify Listeners</span></div>
      <div class="stat"><span class="stat-number">7.7M</span><span class="stat-label">Spotify Streams</span></div>
      <div class="stat"><span class="stat-number">28.4K</span><span class="stat-label">Spotify Followers</span></div>
      <div class="stat"><span class="stat-number">8.3K</span><span class="stat-label">Instagram Followers</span></div>
      <div class="stat"><span class="stat-number">6.7K</span><span class="stat-label">Facebook Followers</span></div>
      <div class="stat"><span class="stat-number">4.5K</span><span class="stat-label">YouTube Followers</span></div>
    </div>

    <img src="/images/image01.jpg" alt="2DCAT Spotify audience data — top markets include Germany, United States, and United Kingdom" class="epk-audience" />

    <div class="epk-bio">
      <p>2DCAT is the Washington, D.C. dark synthpop duo of vocalist HAEZL and synthesist Johan Hauck. HAEZL, who has shared the stage with Patti LaBelle, Cynthia Erivo, and Renée Fleming, brings classically trained power to the dance floor. Johan designs and fabricates most of the synthesizers heard on stage and on record.</p>
      <blockquote>
        An acclaimed opera singer, she brings precision and weight without overstatement: the diction is sharp, the range controlled, and the delivery heavy with the kind of grief that does not need to announce itself theatrically to be devastating.
        <cite>Post-Punk.com</cite>
      </blockquote>
      <p>Based in Washington, D.C., 2DCAT draws from the darkwave and coldwave stylings of late 1970s and early 1980s European synth-driven music. Their high-energy live sets have lit up sold-out club nights and festival stages across the United States and Europe, with a proven draw across darkwave, synthpop, and gothic audiences.</p>
      <blockquote>
        A homemade electrical animal with wires for veins and bad intentions in its little metal heart.
        <cite>Post-Punk.com</cite>
      </blockquote>
      <p class="epk-fans">For fans of Lebanon Hanover, Boy Harsher, and Kite.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <p class="section-label">Photos</p>
    <div class="epk-gallery">
      {galleryImages.map((img, i) => (
        <div class="epk-gallery-item">
          <img src={`/images/${img}`} alt={galleryAlts[i]} />
        </div>
      ))}
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <p class="section-label">Video</p>
    <div class="epk-videos">
      <div class="epk-video-col">
        {videosLeft.map((url) => (
          <div class="epk-video">
            <iframe src={url} frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
        ))}
      </div>
      <div class="epk-video-col">
        {videosRight.map((url) => (
          <div class="epk-video">
            <iframe src={url} frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
        ))}
