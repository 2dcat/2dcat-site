  "IMG-20260727-WA0022.jpg",
  "Echoes-of-Rebellion-2DCat-1.jpg",
  "Echoes-of-Rebellion-2DCat-22.jpg",
];

const alts = [
  "2DCAT live at Echoes of Rebellion, Cologne — photo by black-generation.de",
  "2DCAT live at Echoes of Rebellion, Cologne — photo by HR-Pictures.de",
  "2DCAT live at Echoes of Rebellion, Cologne — photo by black-generation.de",
  "2DCAT live at Echoes of Rebellion, Cologne — photo by Monkeypress",
  "2DCAT live in Leipzig",
  "2DCAT performing darkwave set",
  "2DCAT live at Echoes of Rebellion, Cologne — photo by HR-Pictures.de",
  "2DCAT live at Echoes of Rebellion, Cologne — photo by Monkeypress",
  "HAEZL and Johan of 2DCAT",
  "2DCAT live",
  "Johan performing with 2DCAT",
  "2DCAT live in Cologne",
  "2DCAT live at Echoes of Rebellion, Cologne — photo by black-generation.de",
  "2DCAT live at Echoes of Rebellion, Cologne — photo by black-generation.de",
];

let current = 0;

const lightbox = document.getElementById('epk-lightbox');
const lbImg = document.getElementById('epk-lightbox-img');

function openLightbox(index) {
  current = index;
  lbImg.src = `/images/${images[current]}`;
  lbImg.alt = alts[current];
  lightbox.classList.add('active');
  lightbox.setAttribute('aria-hidden', 'false');
  document.body.style.overflow = 'hidden';
}

function closeLightbox() {
  lightbox.classList.remove('active');
  lightbox.setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
}

function prevImage() {
  current = (current - 1 + images.length) % images.length;
  lbImg.src = `/images/${images[current]}`;
  lbImg.alt = alts[current];
}

function nextImage() {
  current = (current + 1) % images.length;
  lbImg.src = `/images/${images[current]}`;
  lbImg.alt = alts[current];
}

document.querySelectorAll('.epk-gallery-item').forEach((item) => {
  item.addEventListener('click', () => openLightbox(parseInt(item.dataset.index)));
});

document.getElementById('epk-lightbox-close').addEventListener('click', closeLightbox);
document.getElementById('epk-lightbox-prev').addEventListener('click', (e) => { e.stopPropagation(); prevImage(); });
document.getElementById('epk-lightbox-next').addEventListener('click', (e) => { e.stopPropagation(); nextImage(); });

lightbox.addEventListener('click', (e) => {
  if (e.target === lightbox) closeLightbox();
});

document.addEventListener('keydown', (e) => {
  if (!lightbox.classList.contains('active')) return;
  if (e.key === 'Escape') closeLightbox();
  if (e.key === 'ArrowLeft') prevImage();
  if (e.key === 'ArrowRight') nextImage();
});

// PDF
document.getElementById('epk-pdf-btn').addEventListener('click', async function () {
  const btn = this;
  btn.textContent = 'Generating PDF...';
  btn.disabled = true;

  await Promise.all([
    loadScript('https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js'),
    loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js'),
  ]);

  const hideSelectors = ['nav', 'header', 'footer', '.booking-top', '.epk-video'];
  const hidden = [];
  hideSelectors.forEach(sel => {
    document.querySelectorAll(sel).forEach(el => {
      hidden.push({ el, display: el.style.display });
      el.style.display = 'none';
    });
  });

  const videoSection = document.querySelector('.epk-videos');
  let videoNote = null;
  if (videoSection) {
    videoNote = document.createElement('p');
    videoNote.textContent = 'Video performances available at 2dcat.com/epk';
    videoNote.style.cssText = 'color:#CCC3B2;font-size:0.9rem;letter-spacing:0.05em;padding:1rem 0;';
    videoSection.parentNode.insertBefore(videoNote, videoSection);
  }

  const captureTarget = document.body;
  const originalWidth = captureTarget.style.width;
  const originalOverflow = document.documentElement.style.overflow;
  document.documentElement.style.overflow = 'visible';

  try {
    const canvas = await html2canvas(captureTarget, {
      scale: 1.5,
      useCORS: true,
      allowTaint: false,
      backgroundColor: '#0a0a0a',
      width: 1400,
      windowWidth: 1400,
      scrollX: 0,
      scrollY: 0,
      logging: false,
      imageTimeout: 10000,
      onclone: (clonedDoc) => {
        clonedDoc.documentElement.style.background = '#0a0a0a';
        clonedDoc.body.style.background = '#0a0a0a';
      }
    });

    const { jsPDF } = window.jspdf;
    const imgWidth = 210;
    const pageHeight = 297;
    const imgHeight = (canvas.height * imgWidth) / canvas.width;

    const pdf = new jsPDF({
      orientation: imgHeight > imgWidth ? 'portrait' : 'landscape',
      unit: 'mm',
      format: [imgWidth, pageHeight],
      compress: true,
    });

    let remainingHeight = imgHeight;
    let pageNum = 0;

    while (remainingHeight > 0) {
      if (pageNum > 0) pdf.addPage();
      const sourceY = (pageNum * pageHeight * canvas.width) / imgWidth;
      const sourceHeight = Math.min((pageHeight * canvas.width) / imgWidth, canvas.height - sourceY);
      const sliceCanvas = document.createElement('canvas');
      sliceCanvas.width = canvas.width;
      sliceCanvas.height = sourceHeight;
      const ctx = sliceCanvas.getContext('2d');
      ctx.drawImage(canvas, 0, -sourceY);
      const sliceData = sliceCanvas.toDataURL('image/jpeg', 0.88);
      const sliceHeightMm = (sourceHeight * imgWidth) / canvas.width;
      pdf.addImage(sliceData, 'JPEG', 0, 0, imgWidth, sliceHeightMm);
      remainingHeight -= pageHeight;
      pageNum++;
    }

    pdf.setProperties({
      title: '2DCAT EPK — Dark Synthpop Press Kit',
      subject: 'Electronic Press Kit',
      author: '2DCAT',
      keywords: 'dark synthpop, darkwave, Washington DC, 2DCAT',
      creator: '2dcat.com',
    });

    pdf.save('2DCAT-EPK.pdf');

  } catch (err) {
    console.error('EPK PDF generation failed:', err);
    alert('PDF generation failed. Please try again or contact booking@2dcat.net for press assets.');
  } finally {
    hidden.forEach(({ el, display }) => { el.style.display = display; });
    if (videoNote) videoNote.remove();
    document.documentElement.style.overflow = originalOverflow;
    captureTarget.style.width = originalWidth;
    btn.textContent = 'Download EPK as PDF';
    btn.disabled = false;
  }
});

function loadScript(src) {
  return new Promise((resolve, reject) => {
    if (document.querySelector(`script[src="${src}"]`)) { resolve(); return; }
    const s = document.createElement('script');
    s.src = src;
    s.onload = resolve;
    s.onerror = reject;
    document.head.appendChild(s);
  });
}
</script>