        <tr><td><a href="https://www.setlist.fm/setlist/2dcat/2025/cult-classic-brewing-company-stevensville-md-1b420d58.html" target="_blank" rel="noopener">Cult Classic Brewing</a></td><td>Kent Island, MD</td><td>Jul 24, 2025</td><td>185</td></tr>
        <tr><td><a href="https://www.washingtonpost.com/dc-md-va/2025/07/17/best-things-to-do-dc-events/" target="_blank" rel="noopener">Penn Social</a></td><td>Washington, DC</td><td>Jul 19, 2025</td><td>500</td></tr>
        <tr><td><a href="https://www.facebook.com/events/775637498119943/" target="_blank" rel="noopener">The Renegade</a></td><td>Arlington, VA</td><td>Jul 17, 2025</td><td>300</td></tr>
        <tr><td><a href="https://www.facebook.com/events/1234022641450508" target="_blank" rel="noopener">QXT's</a></td><td>Newark, NJ</td><td>Jun 21, 2025</td><td>300</td></tr>
        <tr><td><a href="https://www.facebook.com/events/1406388667167798" target="_blank" rel="noopener">Remedy</a></td><td>Pittsburgh, PA</td><td>Jun 19, 2025</td><td>80</td></tr>
        <tr><td><a href="https://www.facebook.com/events/1033350351691339" target="_blank" rel="noopener">Metro Baltimore</a></td><td>Baltimore, MD</td><td>Sep 21, 2024</td><td>250</td></tr>
        <tr><td><a href="https://www.facebook.com/events/2519398508254113" target="_blank" rel="noopener">The Passenger</a></td><td>Washington, DC</td><td>Aug 2, 2024</td><td>100</td></tr>
        <tr><td><a href="https://www.facebook.com/events/369905078784668" target="_blank" rel="noopener">Pie Shop</a></td><td>Washington, DC</td><td>Apr 23, 2024</td><td>150</td></tr>
        <tr><td><a href="https://www.facebook.com/events/1062512198140670/" target="_blank" rel="noopener">The Crack Fox</a></td><td>St. Louis, MO</td><td>Apr 18, 2024</td><td>200</td></tr>
        <tr><td><a href="https://www.facebook.com/events/1508399573035411" target="_blank" rel="noopener">The Runaway</a></td><td>Washington, DC</td><td>Jan 13, 2024</td><td>150</td></tr>
