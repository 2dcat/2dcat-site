      <tbody>
        <tr><td><a href="https://renramos.bandcamp.com/merch/13-tridecaphobia" target="_blank" rel="noopener">Nocturnazine <span class="press-context">(Issue 13)</span></a></td><td>Album Review</td></tr>
        <tr><td><a href="https://post-punk.com/dc-dark-synthpop-duo-2dcat-take-a-sledgehammer-to-grief-in-video-for-lynchian-blue-rose-edit-of-frames/" target="_blank" rel="noopener">Post-Punk.com</a></td><td>Feature / Video Premiere</td></tr>
        <tr><td><a href="https://post-punk.com/keep-us-blinded-and-starving-dc-dark-synthpop-duo-2dcat-take-class-rage-to-the-factory-floor-in-video-for-eat-the-rich/" target="_blank" rel="noopener">Post-Punk.com</a></td><td>Feature</td></tr>
