<style>
.crawl-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  border: 0;
}
.booking-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1.5rem;
  padding: 1.5rem 2rem;
  border: 1px solid var(--accent);
  margin-bottom: 1rem;
}
.booking-avail {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin: 0;
}
.booking-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  align-items: center;
}
.epk-btn-primary {
  border-color: var(--accent);
  color: var(--accent);
}
.epk-hero-img {
  width: 100%;
  max-height: 500px;
  object-fit: cover;
  object-position: center top;
  display: block;
}
.epk-audience {
  width: 100%;
  max-width: 700px;
  display: block;
  margin: 2rem auto;
}
.epk-bio {
  max-width: 800px;
  margin: 2rem auto 0;
  text-align: center;
}
.epk-bio blockquote { text-align: left; }
.epk-bio p { margin-bottom: 1.5rem; }
.epk-fans { color: var(--text-muted); }

/* Gallery grid — 3 columns, no cropping, max-height per image */
.epk-gallery {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.5rem;
  margin-top: 1rem;
}
.epk-gallery-item {
  overflow: hidden;
  cursor: pointer;
  background: #111;
}
.epk-gallery-item img {
  width: 100%;
  height: auto;
  max-height: 350px;
  object-fit: contain;
  display: block;
  transition: opacity 0.2s;
}
.epk-gallery-item:hover img {
  opacity: 0.85;
}

/* Lightbox */
.epk-lightbox {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.92);
  z-index: 9999;
  align-items: center;
  justify-content: center;
}
.epk-lightbox.active {
  display: flex;
}
.epk-lightbox-img {
  max-width: 90vw;
  max-height: 90vh;
  object-fit: contain;
  display: block;
}
.epk-lightbox-close,
.epk-lightbox-prev,
.epk-lightbox-next {
  position: absolute;
  background: none;
  border: none;
  color: #fff;
  font-size: 2rem;
  cursor: pointer;
  padding: 1rem;
  opacity: 0.7;
  transition: opacity 0.2s;
}
.epk-lightbox-close:hover,
.epk-lightbox-prev:hover,
.epk-lightbox-next:hover { opacity: 1; }
.epk-lightbox-close { top: 1rem; right: 1.5rem; font-size: 2.5rem; }
.epk-lightbox-prev { left: 1rem; top: 50%; transform: translateY(-50%); }
.epk-lightbox-next { right: 1rem; top: 50%; transform: translateY(-50%); }

.epk-videos {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-top: 1rem;
}
.epk-video-col {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.epk-video iframe {
  width: 100%;
  aspect-ratio: 16/9;
  display: block;
}
.shows-title {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-align: center;
  color: var(--text);
  margin-top: 0.5rem;
}
.press-context {
  font-size: 0.8em;
  color: var(--text-muted);
}
.epk-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}
.epk-btn {
  border: 1px solid var(--border);
  padding: 0.75rem 1.5rem;
  display: inline-block;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-size: 0.8rem;
  font-family: var(--font-display);
  transition: border-color 0.2s, color 0.2s;
  color: var(--text);
}
.epk-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
}
.epk-btn-print {
  background: none;
  cursor: pointer;
}
@media (max-width: 768px) {
  .epk-videos { grid-template-columns: 1fr; }
  .epk-gallery { grid-template-columns: repeat(2, 1fr); }
  .booking-bar { flex-direction: column; align-items: flex-start; }
}
</style>

<script>
// Lightbox
const images = [
  "Echoes-of-Rebellion-2DCat-55.jpg",
  "FB_IMG_1785350295046.jpg",
  "Echoes-of-Rebellion-2DCat-54.jpg",
  "2026-07-24-EOR-2DCAT-Bild-009x.jpg",
  "IMG-20260731-WA0032.jpg",
