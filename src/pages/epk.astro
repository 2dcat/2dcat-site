<style>
.crawl-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  border: 0;
}
.booking-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1.5rem;
  padding: 1.5rem 2rem;
  border: 1px solid var(--accent);
  margin-bottom: 1rem;
}
.booking-avail {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin: 0;
}
.booking-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  align-items: center;
}
.epk-btn-primary {
  border-color: var(--accent);
  color: var(--accent);
}
.epk-hero-img {
  width: 100%;
  max-height: 500px;
  object-fit: cover;
  object-position: center top;
  display: block;
}
.epk-audience {
  width: 100%;
  max-width: 700px;
  display: block;
  margin: 2rem auto;
}
.epk-bio {
  max-width: 800px;
  margin: 2rem auto 0;
  text-align: center;
}
.epk-bio blockquote { text-align: left; }
.epk-bio p { margin-bottom: 1.5rem; }
.epk-fans { color: var(--text-muted); }
.epk-gallery {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 0.5rem;
  margin-top: 1rem;
}
.epk-gallery-item img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  display: block;
}
.epk-videos {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-top: 1rem;
}
.epk-video-col {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.epk-video iframe {
  width: 100%;
  aspect-ratio: 16/9;
  display: block;
}
.shows-title {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-align: center;
  color: var(--text);
  margin-top: 0.5rem;
}
.press-context {
  font-size: 0.8em;
  color: var(--text-muted);
}
.epk-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}
.epk-btn {
  border: 1px solid var(--border);
  padding: 0.75rem 1.5rem;
  display: inline-block;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-size: 0.8rem;
  font-family: var(--font-display);
  transition: border-color 0.2s, color 0.2s;
  color: var(--text);
}
.epk-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
}
.epk-btn-print {
  background: none;
  cursor: pointer;
}
@media (max-width: 768px) {
  .epk-videos { grid-template-columns: 1fr; }
  .epk-gallery { grid-template-columns: repeat(2, 1fr); }
  .booking-bar { flex-direction: column; align-items: flex-start; }
}
</style>

<script>
document.getElementById('epk-pdf-btn').addEventListener('click', async function () {
  const btn = this;
  btn.textContent = 'Generating PDF...';
  btn.disabled = true;

  // Load libraries dynamically so they don't bloat the page for regular visitors
  await Promise.all([
    loadScript('https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js'),
    loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js'),
  ]);

  // Elements to hide during capture (nav, booking bar, footer, video iframes)
  // We hide iframes because html2canvas can't cross-origin capture them anyway
  const hideSelectors = [
    'nav',
    'header',
    'footer',
    '.booking-top',       // the booking bar section at the top
    '.epk-video',         // YouTube iframes — show placeholder instead
  ];

  const hidden = [];
  hideSelectors.forEach(sel => {
    document.querySelectorAll(sel).forEach(el => {
      hidden.push({ el, display: el.style.display });
      el.style.display = 'none';
    });
  });

  // Add a video placeholder note so the PDF isn't just blank space there
  const videoSection = document.querySelector('.epk-videos');
  let videoNote = null;
  if (videoSection) {
    videoNote = document.createElement('p');
    videoNote.textContent = 'Video performances available at 2dcat.com/epk';
    videoNote.style.cssText = 'color:#CCC3B2;font-size:0.9rem;letter-spacing:0.05em;padding:1rem 0;';
    videoSection.parentNode.insertBefore(videoNote, videoSection);
  }

  // Capture the full page body at 1400px wide
  const captureTarget = document.body;
  const originalWidth = captureTarget.style.width;
  const originalOverflow = document.documentElement.style.overflow;

  // Temporarily force full render width for the screenshot
  document.documentElement.style.overflow = 'visible';

  try {
    const canvas = await html2canvas(captureTarget, {
      scale: 1.5,              // 1.5x for sharpness without huge file size
      useCORS: true,           // needed for /images/ assets
      allowTaint: false,
      backgroundColor: '#0a0a0a',  // match site dark background
      width: 1400,
      windowWidth: 1400,
      scrollX: 0,
      scrollY: 0,
      logging: false,
      imageTimeout: 10000,
      onclone: (clonedDoc) => {
        // Force the cloned document to also be dark-background
        clonedDoc.documentElement.style.background = '#0a0a0a';
        clonedDoc.body.style.background = '#0a0a0a';
      }
    });

    const { jsPDF } = window.jspdf;

    // PDF page is the same width as the canvas, height is auto-paginated
    const imgWidth = 210; // A4 width in mm — wide enough for screens, standard for email
    const pageHeight = 297; // A4 height in mm
    const imgHeight = (canvas.height * imgWidth) / canvas.width;

    const pdf = new jsPDF({
      orientation: imgHeight > imgWidth ? 'portrait' : 'landscape',
      unit: 'mm',
      format: [imgWidth, pageHeight],
      compress: true,
    });

    const imgData = canvas.toDataURL('image/jpeg', 0.88);

    let yPosition = 0;
    let remainingHeight = imgHeight;
    let pageNum = 0;

    // Slice the canvas image across multiple PDF pages
    while (remainingHeight > 0) {
      if (pageNum > 0) pdf.addPage();

      // Source crop: which slice of the image goes on this page
      const sourceY = (pageNum * pageHeight * canvas.width) / imgWidth;
      const sourceHeight = Math.min(
        (pageHeight * canvas.width) / imgWidth,
        canvas.height - sourceY
      );

      // Create a temporary canvas for this slice
      const sliceCanvas = document.createElement('canvas');
      sliceCanvas.width = canvas.width;
      sliceCanvas.height = sourceHeight;
      const ctx = sliceCanvas.getContext('2d');
      ctx.drawImage(canvas, 0, -sourceY);

      const sliceData = sliceCanvas.toDataURL('image/jpeg', 0.88);
      const sliceHeightMm = (sourceHeight * imgWidth) / canvas.width;

      pdf.addImage(sliceData, 'JPEG', 0, 0, imgWidth, sliceHeightMm);

      remainingHeight -= pageHeight;
      pageNum++;
    }

    pdf.setProperties({
      title: '2DCAT EPK — Dark Synthpop Press Kit',
      subject: 'Electronic Press Kit',
      author: '2DCAT',
      keywords: 'dark synthpop, darkwave, Washington DC, 2DCAT',
      creator: '2dcat.com',
    });

    pdf.save('2DCAT-EPK.pdf');

  } catch (err) {
    console.error('EPK PDF generation failed:', err);
    alert('PDF generation failed. Please try again or contact booking@2dcat.net for press assets.');
  } finally {
    // Restore everything
    hidden.forEach(({ el, display }) => { el.style.display = display; });
    if (videoNote) videoNote.remove();
    document.documentElement.style.overflow = originalOverflow;
    captureTarget.style.width = originalWidth;
    btn.textContent = 'Download EPK as PDF';
    btn.disabled = false;
  }
});

function loadScript(src) {
  return new Promise((resolve, reject) => {
    if (document.querySelector(`script[src="${src}"]`)) { resolve(); return; }
    const s = document.createElement('script');
    s.src = src;
    s.onload = resolve;
    s.onerror = reject;
    document.head.appendChild(s);
  });
}
</script>