---
import Base from '../layouts/Base.astro';
---
<Base
  title="Subscribe | 2DCAT"
>
  <section class="section" style="padding-top:7rem">
    <p class="section-label">Mailing List</p>
    <h2>Stay Informed</h2>
    <p style="margin-top:1rem;max-width:500px;color:var(--text-muted)">Show announcements, new releases, and nothing else.</p>

    <div class="subscribe-form">
      <iframe src="https://preview.mailerlite.io/forms/1361349/188657707044046231/share" width="100%" height="280" frameborder="0" scrolling="no" style="border:none"></iframe>
    </div>
  </section>
</Base>

<style>
.subscribe-form {
  margin-top: 2rem;
  max-width: 500px;
}
</style>