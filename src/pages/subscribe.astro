---
import Base from '../layouts/Base.astro';
---
<Base
  title="Subscribe | 2DCAT"
  description="Join the 2DCAT mailing list for show announcements and new releases."
>
  <section class="section" style="padding-top:7rem">
    <p class="section-label">Mailing List</p>
    <h2>Stay Informed</h2>
    <p style="margin-top:1rem;max-width:500px;color:var(--text-muted)">Show announcements and new releases.</p>

    <div class="subscribe-form">
      <input
        type="email"
        id="subscribe-email"
        class="subscribe-input"
        placeholder="Email"
        autocomplete="email"
      />
      <button id="subscribe-btn" class="subscribe-btn">Subscribe</button>
      <p id="subscribe-msg" class="subscribe-msg" style="display:none"></p>
    </div>
  </section>
</Base>

<style>
.subscribe-form {
  margin-top: 2rem;
  max-width: 500px;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.subscribe-input {
  width: 100%;
  padding: 14px 18px;
  background: #111111;
  border: 1px solid var(--border);
  color: var(--text);
  font-family: var(--font-mono);
  font-size: 0.85rem;
  letter-spacing: 0.1em;
  outline: none;
  transition: border-color 0.2s;
}

.subscribe-input::placeholder {
  color: var(--text-muted);
  text-transform: uppercase;
}

.subscribe-input:focus {
  border-color: var(--accent);
}

.subscribe-btn {
  width: 100%;
  padding: 14px 18px;
  background: rgba(200, 32, 42, 0.15);
  border: 1px solid var(--accent);
  color: var(--text);
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.2s;
  animation: pulse-btn 2s ease-in-out infinite;
}

.subscribe-btn:hover {
  background: rgba(200, 32, 42, 0.3);
}

.subscribe-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.subscribe-msg {
  font-size: 0.8rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-top: 0.5rem;
}

@keyframes pulse-btn {
  0%, 100% { box-shadow: none; }
  50% { box-shadow: 0 0 20px rgba(200, 32, 42, 0.5); }
}
</style>

<script>
  const btn = document.getElementById('subscribe-btn');
  const input = document.getElementById('subscribe-email');
  const msg = document.getElementById('subscribe-msg');

  btn.addEventListener('click', async () => {
    const email = input.value.trim();
    if (!email || !email.includes('@')) {
      input.style.borderColor = 'var(--accent)';
      input.focus();
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Subscribing...';

    try {
      const res = await fetch('https://2dcat-mailerlite-subscribe.adam-hauch.workers.dev', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });

      if (res.ok) {
        msg.textContent = 'You\'re on the list.';
        msg.style.display = 'block';
        input.value = '';
        btn.textContent = 'Done';
      } else {
        throw new Error('Failed');
      }
    } catch(e) {
      btn.disabled = false;
      btn.textContent = 'Subscribe';
      msg.textContent = 'Something went wrong. Try again.';
      msg.style.display = 'block';
    }
  });
</script>