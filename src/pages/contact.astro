---
import Base from '../layouts/Base.astro';
---
<Base
  title="Contact | 2DCAT"
  description="Book 2DCAT for shows in North America and Europe."
>
  <section class="section" style="padding-top:7rem">
    <p class="section-label">Contact</p>
    <h2>Booking & Press</h2>

    <div style="margin-top:3rem;display:flex;flex-direction:column;gap:2rem;max-width:500px">
      <div>
        <p class="contact-label">Booking</p>
        <a href="mailto:booking@2dcat.net">booking@2dcat.net</a>
        <p style="margin-top:0.5rem;color:var(--text-muted);font-size:0.85rem">Available for North America and Europe.</p>
      </div>
      <div>
        <p class="contact-label">Press Assets</p>
        <a href="https://drive.google.com/drive/u/1/folders/1oLPjSo92WIupT8DdGqErdnZNEKIVR7O9" target="_blank" rel="noopener">Press Assets & Tech Rider</a>
      </div>
      <div>
        <p class="contact-label">Social</p>
        <div style="display:flex;flex-direction:column;gap:0.5rem">
          <a href="https://www.instagram.com/the2dcat/" target="_blank" rel="noopener">Instagram</a>
          <a href="https://www.facebook.com/the2dcat" target="_blank" rel="noopener">Facebook</a>
          <a href="https://www.youtube.com/@2dcat" target="_blank" rel="noopener">YouTube</a>
          <a href="https://2dcat.bandcamp.com/" target="_blank" rel="noopener">Bandcamp</a>
          <a href="https://open.spotify.com/artist/78CkUkpoNpLZbnIOv00M6Q" target="_blank" rel="noopener">Spotify</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
.contact-label {
  font-family: var(--font-display);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.5rem;
}
</style>