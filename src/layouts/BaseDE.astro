---
const {
  title = "2DCAT | Dunkler Synthpop aus Washington DC",
  description = "2DCAT ist ein Dark-Synthpop-Duo aus Washington, D.C. Analoggetriebene Synthesizer, markante Vocals und maschinengetriebene Rhythmen.",
  ogImage = "https://2dcat.com/og.jpg",
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content="2DCAT, Dark Synthpop, Darkwave, Coldwave, analoge Synthesizer, Washington DC, elektronische Musik, Schwarze Szene" />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="2DCAT" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:url" content={canonicalURL} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Trade+Gothic+Next+Condensed:wght@400;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <header>
    <nav>
      <a href="/de" class="site-logo">2DCAT</a>
      <ul>
        <li><a href="https://2dcat-music.myshopify.com/" target="_blank" rel="noopener">Merch</a></li>
        <li><a href="/de/about">Über 2DCAT</a></li>
        <li><a href="/de/subscribe">Newsletter</a></li>
        <li><a href="/de/epk">EPK</a></li>
        <li><a href="https://links.2dcat.com/" target="_blank" rel="noopener">Links</a></li>
        <li><a href="/de/contact">Kontakt</a></li>
        <li><a href="/" title="English Version">🇺🇸</a></li>
      </ul>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <p>2DCAT &copy; {new Date().getFullYear()} &mdash; Washington, D.C.</p>
    <div class="footer-links">
      <a href="https://open.spotify.com/artist/78CkUkpoNpLZbnIOv00M6Q" target="_blank" rel="noopener">Spotify</a>
      <a href="https://www.instagram.com/the2dcat/" target="_blank" rel="noopener">Instagram</a>
      <a href="https://www.facebook.com/the2dcat" target="_blank" rel="noopener">Facebook</a>
      <a href="https://www.youtube.com/@2dcat" target="_blank" rel="noopener">YouTube</a>
      <a href="https://2dcat.bandcamp.com/" target="_blank" rel="noopener">Bandcamp</a>
    </div>
  </footer>
</body>
</html>